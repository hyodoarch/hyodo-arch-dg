        <div class="folder-note-list">
      
          {% for note in listingNotes %}
            <article class="folder-note-card">
      
              {% if note.thumbnail %}
                <a href="{{ note.url | escape }}" class="folder-note-thumbnail-link">
                  <img
                    src="{{ note.thumbnail | escape }}"
                    alt="{{ note.title | escape }}"
                    class="folder-note-thumbnail"
                    loading="lazy"
                  >
                </a>
              {% endif %}
      
              <div class="folder-note-body">
      
                <h2 class="folder-note-title">
                  <a class="internal-link" href="{{ note.url | escape }}">
                    {{ note.title | escape }}
                  </a>
                </h2>
      
                {% if note.description %}
                  <p class="folder-note-description">
                    {{ note.description | escape }}
                  </p>
                {% endif %}
      
              </div>
      
            </article>
          {% endfor %}
      
        </div>

