<button class="hyodo-back-to-top" type="button" aria-label="ページの先頭に戻る" title="上に戻る">
  <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m6 14 6-6 6 6"/></svg>
</button>
<script>
  (() => {
    const button = document.querySelector('.hyodo-back-to-top');
    const main = document.querySelector('main');
    const updatePosition = () => {
      if (main) button.style.setProperty('--hyodo-back-to-top-left', `${main.getBoundingClientRect().left + 15}px`);
    };
    updatePosition();
    window.addEventListener('resize', updatePosition);
    window.addEventListener('load', updatePosition);
    if (main) new ResizeObserver(updatePosition).observe(main);
    button.addEventListener('click', function () {
      window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    });
  })();
</script>
