<script type="module">
import { forceSimulation, forceManyBody, forceCenter, forceLink, forceCollide, forceRadial } from 'd3-force';
import { select } from 'd3-selection';
import { zoom as d3Zoom, zoomIdentity } from 'd3-zoom';
import { drag as d3Drag } from 'd3-drag';

// Pixi v7 loaded as UMD global
const { Application, Container, Graphics, Text, Circle } = PIXI;

function graphForDisplay(graphData) {
    if (!graphData) return null;
    const nodes = Object.values(graphData.nodes);
    const links = [...graphData.links];
    nodes.push(...(graphData.tagNodes ?? []).map(node => ({ ...node, tag: true })));
    links.push(...(graphData.tagLinks ?? []));
    return { nodes, links };
}

function filterFullGraphData(graphData) {
    if (!graphData) return null;
    const nodes = graphData.nodes.filter(node => !node.hide);
    const ids = new Set(nodes.map(node => node.id));
    return {
        nodes,
        links: graphData.links.filter(l => ids.has(l.source) && ids.has(l.target)),
    };
}

function filterLocalGraphData(graphData, depth) {
    if (!graphData) return null;
    const { nodes: allNodes, links: allLinks } = graphData;
    const currentLink = decodeURI(window.location.pathname);
    const lower = currentLink.toLowerCase();
    const currentNode = allNodes.find(node => node.url === currentLink) ??
        allNodes.find(node => node.url?.toLowerCase() === lower) ??
        allNodes.find(node => node.home);
    if (!currentNode) return null;

    // Hidden nodes (home page, index/hub pages like the-shelf or entity-index)
    // are never rendered, but they're linked from a huge number of pages. If we
    // let BFS walk through them as ordinary hops, they silently bridge otherwise
    // unrelated parts of the graph together — the hidden hop then gets dropped
    // from the output, leaving nodes that appear with no visible path to the
    // current node. So a hidden node can only ever be a traversal *endpoint*
    // (reached from, never walked through), except the current node itself,
    // whose own direct links must still count even if it happens to be hidden
    // (e.g. viewing the local graph on the home page).
    const hiddenIds = new Set(allNodes.filter(n => n.hide).map(n => n.id));
    const canBridge = id => id === currentNode.id || !hiddenIds.has(id);

    // Build an id-based adjacency map so we can walk out to arbitrary depth
    const adjacency = {};
    for (const l of allLinks) {
        if (!canBridge(l.source) || !canBridge(l.target)) continue;
        (adjacency[l.source] = adjacency[l.source] || new Set()).add(l.target);
        (adjacency[l.target] = adjacency[l.target] || new Set()).add(l.source);
    }

    // BFS out from the current node up to `depth` hops
    const visited = new Set([currentNode.id]);
    let frontier = new Set([currentNode.id]);
    for (let i = 0; i < depth && frontier.size > 0; i++) {
        const next = new Set();
        for (const id of frontier) {
            for (const neighborId of (adjacency[id] || [])) {
                if (!visited.has(neighborId)) {
                    visited.add(neighborId);
                    next.add(neighborId);
                }
            }
        }
        frontier = next;
    }

    const nodes = allNodes.filter(n => !n.hide && visited.has(n.id))
        .map(node => ({
            ...node,
            current: node === currentNode,
            direct: node === currentNode || adjacency[currentNode.id]?.has(node.id),
        }));
    const ids = new Set(nodes.map(n => n.id));
    return {
        nodes,
        links: allLinks.filter(l => ids.has(l.target) && ids.has(l.source)),
    };
}

function getCssVar(variable) {
    return getComputedStyle(document.body).getPropertyValue(variable).trim();
}

// Resolve CSS color (which may contain calc/hsl) to a hex number Pixi can use
const _colorProbe = document.createElement('div');
_colorProbe.style.display = 'none';
document.body.appendChild(_colorProbe);
function resolveColor(cssValue) {
    _colorProbe.style.color = cssValue;
    const resolved = getComputedStyle(_colorProbe).color;
    const match = resolved.match(/(\d+),\s*(\d+),\s*(\d+)/);
    if (match) {
        return (parseInt(match[1]) << 16) + (parseInt(match[2]) << 8) + parseInt(match[3]);
    }
    return 0x666666;
}

// Lightweight HTML entity decoder
const _decodeEl = document.createElement('textarea');
function htmlDecode(input) {
    _decodeEl.innerHTML = input;
    return _decodeEl.value;
}

// Pre-compute degree map for node sizing
function buildDegreeMap(links) {
    const degrees = {};
    for (const l of links) {
        const sid = typeof l.source === 'object' ? l.source.id : l.source;
        const tid = typeof l.target === 'object' ? l.target.id : l.target;
        degrees[sid] = (degrees[sid] || 0) + 1;
        degrees[tid] = (degrees[tid] || 0) + 1;
    }
    return degrees;
}

function nodeRadius(nodeId, degreeMap) {
    return 4 + Math.min(5, Math.sqrt(degreeMap[nodeId] || 0));
}

function renderGraph(graphData, containerId, isFullScreen, labelSize = 13) {
    if (!graphData || !graphData.nodes || graphData.nodes.length === 0) return null;

    const el = document.getElementById(containerId);
    if (!el) return null;

    while (el.firstChild) el.removeChild(el.firstChild);

    const width = el.clientWidth;
    const height = el.clientHeight || 250;
    if (width === 0) return null;

    const color = resolveColor(getCssVar('--dg-graph-node-color') || getCssVar('--graph-main') || '#666');
    const mutedColor = resolveColor(getCssVar('--dg-graph-node-color-muted') || getCssVar('--graph-muted') || '#ccc');
    const tagColor = resolveColor(getCssVar('--dg-graph-tag-color') || '#4e6799');
    const textColor = resolveColor(getCssVar('--dg-graph-label-color') || getCssVar('--text-normal') || '#eee');
    const bodyFont = getComputedStyle(document.body).fontFamily || 'Sans-Serif';
    const labelFontSize = parseFloat(getCssVar('--dg-graph-label-size')) || labelSize;

    const degreeMap = buildDegreeMap(graphData.links);

    const nodes = graphData.nodes.map(n => ({
        ...n,
        text: n.tag ? n.title : htmlDecode(n.title),
    }));
    const links = graphData.links.map(l => ({ source: l.source, target: l.target }));

    const chargeStrength = isFullScreen ? -80 : -100;
    const linkDist = 40;
    const radius = Math.min(width, height) / 3;
    let layoutScale = 1;
    const collisionRadius = d => (nodeRadius(d.id, degreeMap) + 3) / layoutScale;
    const collision = forceCollide(collisionRadius).iterations(3);
    const simulation = forceSimulation(nodes)
        .force('charge', forceManyBody().strength(chargeStrength))
        .force('center', forceCenter(width / 2, height / 2).strength(0.5))
        .force('link', forceLink(links).id(d => d.id).distance(linkDist))
        .force('collide', collision)
        .force('radial', forceRadial(radius, width / 2, height / 2).strength(0.05));

    // Pixi v7 Application (synchronous constructor)
    const app = new Application({
        width,
        height,
        antialias: true,
        autoStart: false,
        autoDensity: true,
        backgroundAlpha: 0,
        resolution: window.devicePixelRatio,
    });
    el.appendChild(app.view);

    const stage = app.stage;
    stage.interactive = true;
    stage.hitArea = app.screen;

    const linkGfx = new Graphics();
    const nodesContainer = new Container();
    const labelsContainer = new Container();
    stage.addChild(linkGfx, nodesContainer, labelsContainer);

    let hoveredNodeId = null;
    let hoveredNeighbours = new Set();
    let dragging = false;
    let dragStartTime = 0;
    let dragStartPos = null;
    let currentTransform = zoomIdentity;

    const nodeRenderData = [];
    const linkRenderData = [];

    function updateHoverInfo(newId) {
        hoveredNodeId = newId;
        hoveredNeighbours.clear();

        if (newId === null) {
            for (const n of nodeRenderData) n.active = false;
            for (const l of linkRenderData) l.active = false;
        } else {
            for (const l of linkRenderData) {
                const src = l.simulationData.source;
                const tgt = l.simulationData.target;
                const srcId = typeof src === 'object' ? src.id : src;
                const tgtId = typeof tgt === 'object' ? tgt.id : tgt;
                if (srcId === newId || tgtId === newId) {
                    hoveredNeighbours.add(srcId);
                    hoveredNeighbours.add(tgtId);
                }
                l.active = srcId === newId || tgtId === newId;
            }
            for (const n of nodeRenderData) {
                n.active = hoveredNeighbours.has(n.simulationData.id);
            }
        }
    }

    // Create node graphics
    for (const n of nodes) {
        const r = nodeRadius(n.id, degreeMap);

        const label = new Text(n.text, {
            fontSize: labelFontSize,
            fill: textColor,
            fontFamily: bodyFont,
            wordWrap: true,
            breakWords: true,
            wordWrapWidth: Math.min(260, width - 16),
            stroke: getCssVar('--dg-graph-bg') || '#fff',
            strokeThickness: 3,
            lineJoin: 'round',
        });
        label.resolution = 2;
        const labelBounds = label.getLocalBounds();

        const gfx = new Graphics();
        gfx.interactive = true;
        gfx.cursor = n.url ? 'pointer' : 'default';
        gfx.hitArea = new Circle(0, 0, r + 2);
        gfx._nodeId = n.id;

        const nodeColor = n.tag ? tagColor : n.current ? color : mutedColor;
        gfx.beginFill(nodeColor);
        gfx.drawCircle(0, 0, r);
        gfx.endFill();

        if (n.current) {
            gfx.lineStyle(0.5, color);
            gfx.drawCircle(0, 0, r + 1.5);
        }

        gfx.on('pointerover', () => {
            updateHoverInfo(gfx._nodeId);
            if (!dragging) updateVisuals();
        });
        gfx.on('pointerleave', () => {
            if (dragging) return;
            updateHoverInfo(null);
            updateVisuals();
        });

        nodesContainer.addChild(gfx);
        labelsContainer.addChild(label);

        nodeRenderData.push({
            simulationData: n,
            gfx,
            label,
            labelWidth: labelBounds.width,
            labelHeight: labelBounds.height,
            radius: r,
            active: false,
            baseAlpha: 1,
            targetAlpha: 1,
            currentAlpha: 1,
        });
    }

    for (const l of links) {
        linkRenderData.push({
            simulationData: l,
            active: false,
            baseAlpha: 0.4,
            targetAlpha: 0.4,
            currentAlpha: 0.4,
        });
    }

    function updateVisuals() {
        for (const n of nodeRenderData) {
            n.targetAlpha = hoveredNodeId !== null ? (n.active ? 1 : 0.1) : n.baseAlpha;
        }
        for (const l of linkRenderData) {
            l.targetAlpha = hoveredNodeId !== null ? (l.active ? 0.8 : 0.05) : l.baseAlpha;
        }
    }

    function lerp(a, b, t) {
        return a + (b - a) * t;
    }

    function placeLabels() {
        const occupied = [];
        const priority = n => {
            if (n.simulationData.id === hoveredNodeId) return 0;
            if (n.simulationData.current) return 1;
            if (n.active) return 2;
            if (n.simulationData.direct) return 3;
            return 4;
        };
        const ordered = [...nodeRenderData].sort((a, b) =>
            priority(a) - priority(b) ||
            (degreeMap[b.simulationData.id] || 0) - (degreeMap[a.simulationData.id] || 0));
        for (const n of ordered) {
            const x = currentTransform.applyX(n.gfx.x);
            const y = currentTransform.applyY(n.gfx.y);
            n.label.visible = false;
            if (x < 0 || x > width || y < 0 || y > height) continue;
            const w = n.labelWidth;
            const h = n.labelHeight;
            const gap = n.radius + 5;
            const candidates = [
                { x: x - w / 2, y: y - gap - h },
                { x: x + gap, y: y - h / 2 },
                { x: x - w / 2, y: y + gap },
                { x: x - gap - w, y: y - h / 2 },
            ];
            const box = candidates.find(box => {
                box.x = Math.max(4, Math.min(width - w - 4, box.x));
                if (box.y < 4 || box.y + h > height - 4) return false;
                if (occupied.some(other => box.x < other.x + other.w + 4 &&
                    box.x + w + 4 > other.x && box.y < other.y + other.h + 3 &&
                    box.y + h + 3 > other.y)) return false;
                return !nodeRenderData.some(other => {
                    if (other === n) return false;
                    const ox = currentTransform.applyX(other.gfx.x);
                    const oy = currentTransform.applyY(other.gfx.y);
                    return ox + other.radius > box.x && ox - other.radius < box.x + w &&
                        oy + other.radius > box.y && oy - other.radius < box.y + h;
                });
            }) ?? (priority(n) <= 1 ? {
                x: Math.max(4, Math.min(width - w - 4, x - w / 2)),
                y: Math.max(4, Math.min(height - h - 4, y - gap - h)),
            } : null);
            if (!box) continue;
            n.label.position.set(currentTransform.invertX(box.x), currentTransform.invertY(box.y));
            n.label.visible = true;
            n.label.alpha = hoveredNodeId === null || n.active || priority(n) <= 1 ? 1 : 0.35;
            occupied.push({ ...box, w, h });
        }
    }

    // D3 Drag
    select(app.view).call(
        d3Drag()
            .container(() => app.view)
            .subject(event => {
                // Touch input has no hover. Hit-test the same circles that Pixi draws.
                const x = currentTransform.invertX(event.x);
                const y = currentTransform.invertY(event.y);
                const hit = nodeRenderData.findLast(({ gfx, radius }) =>
                    Math.hypot(x - gfx.x, y - gfx.y) <= (radius + 2) / currentTransform.k);
                if (!hit) return null;
                const node = hit.simulationData;
                return {
                    x: node.x * currentTransform.k + currentTransform.x,
                    y: node.y * currentTransform.k + currentTransform.y,
                    node,
                };
            })
            .on('start', function (event) {
                if (!event.active) simulation.alphaTarget(1).restart();
                const node = event.subject.node;
                node.fx = node.x;
                node.fy = node.y;
                dragStartTime = Date.now();
                dragStartPos = { x: event.x, y: event.y };
                dragging = true;
                updateHoverInfo(node.id);
                updateVisuals();
            })
            .on('drag', function (event) {
                const node = event.subject.node;
                node.fx = (event.x - currentTransform.x) / currentTransform.k;
                node.fy = (event.y - currentTransform.y) / currentTransform.k;
            })
            .on('end', function (event) {
                if (!event.active) simulation.alphaTarget(0);
                const node = event.subject.node;
                node.fx = null;
                node.fy = null;
                dragging = false;

                const dt = Date.now() - dragStartTime;
                const dx = event.x - dragStartPos.x;
                const dy = event.y - dragStartPos.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dt < 500 && dist < 5 && node.url && event.sourceEvent.type !== 'touchcancel') {
                    window.location = node.url;
                }
            })
    );

    // D3 Zoom
    const zoomBehavior = d3Zoom()
        .extent([[0, 0], [width, height]])
        .scaleExtent([0.25, 4])
        .on('zoom', ({ transform }) => {
            currentTransform = transform;
            stage.scale.set(transform.k, transform.k);
            stage.position.set(transform.x, transform.y);

        });
    select(app.view).call(zoomBehavior);

    // Animation loop
    let stopAnimation = false;
    const smoothing = 0.15;

    function animate() {
        if (stopAnimation) return;

        for (const n of nodeRenderData) {
            const { x, y } = n.simulationData;
            if (x == null || y == null) continue;
            n.gfx.position.set(x, y);
            n.gfx.scale.set(1 / currentTransform.k);
            n.label.scale.set(1 / currentTransform.k);

            n.currentAlpha = lerp(n.currentAlpha, n.targetAlpha, smoothing);
            n.gfx.alpha = n.currentAlpha;
        }
        placeLabels();

        // Draw all links in a single Graphics pass
        linkGfx.clear();
        for (const l of linkRenderData) {
            const src = l.simulationData.source;
            const tgt = l.simulationData.target;
            if (src.x == null || tgt.x == null) continue;

            l.currentAlpha = lerp(l.currentAlpha, l.targetAlpha, smoothing);

            linkGfx.lineStyle(1 / currentTransform.k, l.active ? color : mutedColor, l.currentAlpha);
            linkGfx.moveTo(src.x, src.y);
            linkGfx.lineTo(tgt.x, tgt.y);
        }

        app.render();
        requestAnimationFrame(animate);
    }

    requestAnimationFrame(animate);

    function initialTransform() {
        let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
        for (const n of nodes) {
            if (n.x == null || n.y == null) continue;
            minX = Math.min(minX, n.x);
            maxX = Math.max(maxX, n.x);
            minY = Math.min(minY, n.y);
            maxY = Math.max(maxY, n.y);
        }
        const padding = 35;
        const gw = Math.max(1, maxX - minX);
        const gh = Math.max(1, maxY - minY);
        const k = Math.min((width - padding * 2) / gw, (height - padding * 2) / gh, 2);
        const cx = (minX + maxX) / 2;
        const cy = (minY + maxY) / 2;

        return zoomIdentity
            .translate(width / 2 - cx * k, height / 2 - cy * k)
            .scale(k);
    }

    // Fit every graph, including a single node, and account for screen-sized circles.
    const fitTimer = setTimeout(() => {
        simulation.tick(120);
        let transform = initialTransform();
        for (let pass = 0; pass < 3; pass++) {
            layoutScale = transform.k;
            collision.radius(collisionRadius);
            simulation.alpha(0.15).tick(80);
            transform = initialTransform();
        }
        zoomBehavior.scaleExtent([Math.min(0.25, transform.k), 4]);
        select(app.view).call(zoomBehavior.transform, transform);
    }, 500);

    return function cleanup() {
        stopAnimation = true;
        clearTimeout(fitTimer);
        simulation.stop();
        select(app.view).on('.drag', null).on('.zoom', null);
        app.destroy(true, { children: true });
    };
}

// --- Initialize ---
let graphDataCache = null;
let localGraphCleanup = null;
let modalGraphCleanup = null;
let modalRenderFrame = null;
let modalMode = null;
let localGraphDepth = 1;
const modal = document.getElementById('full-graph');

async function init() {
    const response = await fetch('/graph.json');
    graphDataCache = await response.json();
    renderLocal();
    if (modalMode) renderModal();
}

function renderLocal() {
    localGraphCleanup?.();
    const data = filterLocalGraphData(graphForDisplay(graphDataCache), localGraphDepth);
    localGraphCleanup = renderGraph(data, 'link-graph', false, localGraphDepth === 3 ? 12 : 13);
}

function setLocalGraphDepth(depth) {
    localGraphDepth = parseInt(depth, 10) || 1;
    renderLocal();
    if (modalMode === 'local') renderModal();
}

function clearModalGraph() {
    if (modalRenderFrame !== null) cancelAnimationFrame(modalRenderFrame);
    modalRenderFrame = null;
    modalGraphCleanup?.();
    modalGraphCleanup = null;
}

function renderModal() {
    clearModalGraph();
    modalRenderFrame = requestAnimationFrame(() => {
        modalRenderFrame = null;
        const graph = graphForDisplay(graphDataCache);
        const data = modalMode === 'local'
            ? filterLocalGraphData(graph, localGraphDepth)
            : filterFullGraphData(graph);
        modalGraphCleanup = renderGraph(data, 'full-graph-container', true,
            modalMode === 'full' || localGraphDepth === 3 ? 12 : 13);
    });
}

function openModal(mode) {
    if (!modal.open) modal.showModal();
    modalMode = mode;
    renderModal();
}

function openFullGraph() {
    openModal('full');
}

function openExpandedLocal() {
    openModal('local');
}

function closeFullGraph() {
    modalMode = null;
    clearModalGraph();
    modal.close();
}

// Expose to Alpine
window.__graph = { openFullGraph, closeFullGraph, openExpandedLocal, rerenderLocal: renderLocal, setLocalGraphDepth };

// Re-render when the style editor changes CSS variables
document.addEventListener('forestry:css-changed', function() {
    if (graphDataCache) renderLocal();
});

// Recreate the canvas when its responsive container changes dimensions.
const graphSizes = new WeakMap();
const graphResizeObserver = new ResizeObserver(entries => {
    for (const { target, contentRect } of entries) {
        const size = `${Math.round(contentRect.width)}x${Math.round(contentRect.height)}`;
        const previousSize = graphSizes.get(target);
        graphSizes.set(target, size);
        if (!graphDataCache || !previousSize || previousSize === size || !contentRect.width) continue;
        if (target.id === 'link-graph') renderLocal();
        else if (modalMode) renderModal();
    }
});
graphResizeObserver.observe(document.getElementById('link-graph'));
graphResizeObserver.observe(document.getElementById('full-graph-container'));

init();
</script>

<div id="graph-component" class="graph" x-data="{ graphDepth: 1 }">
    <div class="graph-title-container">
        <div class="graph-title">Connected Pages</div>
        <div id="graph-controls">
            {% if settings.dgShowGraphDepthControl %}
            <div class="ctrl-left">
                <label id="graph-depth-label" for="graph-depth-slider">深さ <span x-text="graphDepth"></span></label>
                <input type="range" id="graph-depth-slider" min="1" max="3" step="1" x-model.number="graphDepth" x-on:input="window.__graph.setLocalGraphDepth(graphDepth)" />
            </div>
            {% endif %}
            <div class="ctrl-right">
                <span id="global-graph-btn" x-on:click="window.__graph.openFullGraph()"><i data-lucide="globe" aria-hidden="true"></i></span>
                <span id="graph-fs-btn" x-on:click="window.__graph.openExpandedLocal()"><i data-lucide="expand" aria-hidden="true"></i></span>
            </div>
        </div>
    </div>
    <div id="link-graph"></div>
    <dialog id="full-graph" aria-label="グラフビュー" x-on:click.self="window.__graph.closeFullGraph()" x-on:cancel.prevent="window.__graph.closeFullGraph()">
        <button type="button" id="full-graph-close" aria-label="閉じる" x-on:click="window.__graph.closeFullGraph()"><i data-lucide="x" aria-hidden="true"></i></button>
        <div id="full-graph-container"></div>
    </dialog>
</div>
