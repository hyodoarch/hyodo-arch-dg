{% if tagNotes and tagNotes.length > 0 %}

  <div class="folder-note-list">

    {% for note in tagNotes %}

      <article class="folder-note-card">

        {% if note.thumbnail %}
          <a
            href="{{ note.url }}"
            class="folder-note-thumbnail-link"
          >
            <img
              src="{{ note.thumbnail }}"
              alt="{{ note.title }}"
              class="folder-note-thumbnail"
              loading="lazy"
            >
          </a>
        {% endif %}

        <div class="folder-note-body">

          <h2 class="folder-note-title">
            <a
              class="internal-link"
              href="{{ note.url }}"
            >
              {{ note.title }}
            </a>
          </h2>

          {% if note.description %}
            <p class="folder-note-description">
              {{ note.description }}
            </p>
          {% endif %}

        </div>

      </article>

    {% endfor %}

  </div>

{% else %}

  <p>このタグのノートはありません。</p>

{% endif %}
